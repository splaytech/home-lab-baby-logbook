# Baby Logbook - Environment Configuration
# Copy this file to .env and update the values

# ========================================
# Application Settings
# ========================================
NODE_ENV=production
PORT=3000
TZ=Australia/Melbourne

# ========================================
# Database Configuration
# ========================================
DATABASE_PATH=/data/baby-logbook.db

# ========================================
# Security Settings
# ========================================
# Session secret - Generate a strong random string
# Leave empty to auto-generate (not recommended for production)
SESSION_SECRET=

# Session timeout in milliseconds (default: 7 days)
SESSION_TIMEOUT=604800000

# JWT Authentication
# Generate a strong random string for JWT signing
# Example: openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ========================================
# Backup Settings
# ========================================
# Number of days to retain backups
BACKUP_RETENTION_DAYS=30

# Automatic backup schedule (cron format)
# Default: Daily at 2 AM
BACKUP_SCHEDULE=0 2 * * *

# ========================================
# SMTP Email Settings (Optional)
# ========================================
# Enable/disable email functionality
SMTP_ENABLED=false

# SMTP server configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ========================================
# File Upload Settings
# ========================================
# Maximum file upload size in bytes (default: 10MB)
MAX_FILE_SIZE=10485760

# Allowed image formats
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# ========================================
# Rate Limiting
# ========================================
# Maximum requests per minute per user
RATE_LIMIT_MAX=100

# Maximum login attempts per 15 minutes
LOGIN_ATTEMPTS_MAX=5

# ========================================
# Logging
# ========================================
# Log level: error, warn, info, debug
LOG_LEVEL=info

# Enable file logging (in addition to console)
LOG_TO_FILE=false
